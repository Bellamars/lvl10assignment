import pandas as pd 

data = pd.read_csv("cfb.csv", sep=None, engine="python", encoding="utf-8-sig")


data.columns = data.columns.str.strip()


season_input = input("Enter a season to analyze: ").strip() 

season_data = data[data["Season"].astype(str) == season_input]

if season_data.empty:
    print(f"Season {season_input} was not found in the CSV file.")

else:
    categories = {
        "10 or more wins": [],
        "8–9 wins": [],
        "6–7 wins": [],
        "Fewer than 6 wins": []
    } 

    for _, row in season_data.iterrows():
        team = row["Team"]
        wins = int(row["Win"])

        if wins >= 10:
            categories["10 or more wins"].append(team)
        elif wins >= 8:
            categories["8–9 wins"].append(team)
        elif wins >= 6:
            categories["6–7 wins"].append(team)
        else:
            categories["Fewer than 6 wins"].append(team)

    print(f"\nCollege Football Results for {season_input}")
    
    for category, teams in categories.items():
        print(f"\n{category}:")
        
        for team in teams:
            print(team)